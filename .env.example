# Copy to .env.local and fill in. .env.local is gitignored — never commit keys.

# Public site origin. Drives metadataBase, canonical URLs and the share link.
NEXT_PUBLIC_SITE_URL=https://unu-la-un-milion.com

# Supabase — the anonymous answer log. SERVER ONLY: never prefix with
# NEXT_PUBLIC_, or the key ships to every player's browser.
# The game is fully playable with these unset; logging simply no-ops.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Shared secret for game sessions. Use the same long random value on every instance.
GAME_SESSION_SECRET=
